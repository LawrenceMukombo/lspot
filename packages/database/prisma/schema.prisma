generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// Tenancy, Organization & Branches
// ----------------------------------------------------
model Tenant {
  id          String   @id @default(uuid())
  name        String
  tradingName String?
  tpin        String?
  country     String   @default("Zambia")
  currency    String   @default("ZMW")
  timezone    String   @default("Africa/Lusaka")
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches         Branch[]
  users            User[]
  businessSettings BusinessSetting[]
  stockItems       StockItem[]
  menuItems        MenuItem[]
  sales            Sale[]
  invoices         Invoice[]
  cashierShifts    CashierShift[]
  kitchenRegisters KitchenRegister[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String   @default("MAIN")
  address   String
  phone     String
  email     String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockLocations   StockLocation[]
  sales            Sale[]
  cashierShifts    CashierShift[]
  kitchenRegisters KitchenRegister[]

  @@map("branches")
}

model BusinessSetting {
  id                  String   @id @default(uuid())
  tenantId            String
  operatingHoursStart String   @default("07:00")
  operatingHoursEnd   String   @default("22:00")
  businessCutoffTime  String   @default("23:59")
  cashToleranceZmw    Decimal  @default(5.00) @db.Decimal(14, 2)
  taxRatePercent      Decimal  @default(16.00) @db.Decimal(5, 2)
  taxEnabled          Boolean  @default(false)
  creditLimitCeiling  Decimal  @default(10000.00) @db.Decimal(14, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

// ----------------------------------------------------
// Authentication, Identity & RBAC
// ----------------------------------------------------
model User {
  id           String    @id @default(uuid())
  tenantId     String
  branchId     String?
  username     String    @unique
  fullName     String
  email        String?   @unique
  phone        String?
  passwordHash String
  supervisorPin String?
  role         String    @default("CASHIER")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles     UserRole[]
  cashierShifts CashierShift[]
  sales         Sale[]
  auditEvents   AuditEvent[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ----------------------------------------------------
// Menu & Pricing
// ----------------------------------------------------
model MenuCategory {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItems MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id             String   @id @default(uuid())
  tenantId       String
  branchId       String?
  categoryId     String
  name           String
  description    String?
  sku            String?  @unique
  sellingPrice   Decimal  @db.Decimal(14, 2)
  portionSize    String   @default("Single Portion")
  estimatedCost  Decimal  @default(0.00) @db.Decimal(14, 2)
  isAvailable    Boolean  @default(true)
  recipeId       String?  @unique
  imageUrl       String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     MenuCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  recipe       Recipe?       @relation(fields: [recipeId], references: [id])
  menuPrices   MenuPrice[]
  saleItems    SaleItem[]
  kitchenItems KitchenRegisterItem[]

  @@map("menu_items")
}

model MenuPrice {
  id          String   @id @default(uuid())
  menuItemId  String
  priceType   String   @default("STANDARD") // STANDARD, DINE_IN, TAKEAWAY, SPECIAL
  price       Decimal  @db.Decimal(14, 2)
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("menu_prices")
}

// ----------------------------------------------------
// Recipes & Costing
// ----------------------------------------------------
model Recipe {
  id                   String   @id @default(uuid())
  tenantId             String
  name                 String
  batchQuantity        Decimal  @db.Decimal(12, 4)
  expectedPortionYield Int
  standardCost         Decimal  @default(0.00) @db.Decimal(14, 2)
  instructions         String?
  versionNumber        Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  menuItem          MenuItem?
  recipeIngredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id             String  @id @default(uuid())
  recipeId       String
  stockItemId    String
  quantity       Decimal @db.Decimal(12, 4)
  unitOfMeasure  String
  lossPercentage Decimal @default(0.00) @db.Decimal(5, 2)

  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@map("recipe_ingredients")
}

// ----------------------------------------------------
// Inventory & Perpetual Stock Ledgers
// ----------------------------------------------------
model StockCategory {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockItems StockItem[]

  @@map("stock_categories")
}

model StockLocation {
  id          String   @id @default(uuid())
  tenantId    String
  branchId    String
  name        String
  code        String
  isKitchen   Boolean  @default(false)
  isMainStore Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch               Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sourceMovements      StockMovement[] @relation("SourceMovements")
  destinationMovements StockMovement[] @relation("DestinationMovements")

  @@map("stock_locations")
}

model StockItem {
  id            String   @id @default(uuid())
  tenantId      String
  categoryId    String
  name          String
  sku           String   @unique
  barcode       String?
  unitOfMeasure String   @default("kg")
  reorderLevel  Decimal  @default(5.00) @db.Decimal(12, 4)
  currentStock  Decimal  @default(0.00) @db.Decimal(12, 4)
  averageUnitCost Decimal @default(0.00) @db.Decimal(14, 2)
  totalValue    Decimal  @default(0.00) @db.Decimal(14, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          StockCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  movements         StockMovement[]
  recipeIngredients RecipeIngredient[]

  @@map("stock_items")
}

model StockMovement {
  id                    String   @id @default(uuid())
  tenantId              String
  stockItemId           String
  sourceLocationId      String?
  destinationLocationId String?
  movementType          String
  quantity              Decimal  @db.Decimal(12, 4)
  unitCost              Decimal  @db.Decimal(14, 2)
  totalValue            Decimal  @db.Decimal(14, 2)
  referenceId           String?
  notes                 String?
  createdAt             DateTime @default(now())

  stockItem           StockItem      @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  sourceLocation      StockLocation? @relation("SourceMovements", fields: [sourceLocationId], references: [id])
  destinationLocation StockLocation? @relation("DestinationMovements", fields: [destinationLocationId], references: [id])

  @@map("stock_movements")
}

// ----------------------------------------------------
// Daily Kitchen Production Register
// ----------------------------------------------------
model KitchenRegister {
  id           String   @id @default(uuid())
  tenantId     String
  branchId     String
  businessDate DateTime @db.Date
  status       String   @default("OPEN") // OPEN, CLOSED
  openedAt     DateTime @default(now())
  closedAt     DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items    KitchenRegisterItem[]
  batches  ProductionBatch[]

  @@unique([branchId, businessDate])
  @@map("kitchen_registers")
}

model KitchenRegisterItem {
  id                    String   @id @default(uuid())
  registerId            String
  menuItemId            String
  openingPortions       Int      @default(0)
  preparedPortions      Int      @default(0)
  soldPortions          Int      @default(0)
  wastePortions         Int      @default(0)
  staffMealPortions     Int      @default(0)
  complimentaryPortions Int      @default(0)
  remainingPortions     Int      @default(0)
  closingPortions       Int      @default(0)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  register KitchenRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  menuItem MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([registerId, menuItemId])
  @@map("kitchen_register_items")
}

model ProductionBatch {
  id                     String   @id @default(uuid())
  registerId             String
  menuItemId             String
  plannedPortions        Int
  actualPreparedPortions Int
  status                 String   @default("COMPLETED")
  chefId                 String?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  register KitchenRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@map("production_batches")
}

// ----------------------------------------------------
// Customers & Accounts Receivable (Credit)
// ----------------------------------------------------
model Customer {
  id               String   @id @default(uuid())
  tenantId         String
  customerType     String   @default("INDIVIDUAL") // INDIVIDUAL, CORPORATE
  name             String
  phone            String
  email            String?
  tpin             String?
  address          String?
  creditLimit      Decimal  @default(0.00) @db.Decimal(14, 2)
  currentBalance   Decimal  @default(0.00) @db.Decimal(14, 2)
  paymentTermsDays Int      @default(30)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sales    Sale[]
  invoices Invoice[]

  @@map("customers")
}

// ----------------------------------------------------
// Point of Sale & Transactions
// ----------------------------------------------------
model Sale {
  id             String   @id @default(uuid())
  tenantId       String
  branchId       String
  saleNumber     String   @unique
  shiftId        String?
  cashierId      String
  customerId     String?
  orderType      String   @default("DINE_IN") // DINE_IN, TAKEAWAY
  tableNumber    String?
  subtotal       Decimal  @db.Decimal(14, 2)
  discountAmount Decimal  @default(0.00) @db.Decimal(14, 2)
  taxAmount      Decimal  @default(0.00) @db.Decimal(14, 2)
  totalAmount    Decimal  @db.Decimal(14, 2)
  paymentStatus  String   @default("PAID") // PAID, PARTIALLY_PAID, UNPAID, CREDIT, REFUNDED
  zraStatus      String   @default("NOT_APPLICABLE")
  fiscalInvoiceNo String?
  idempotencyKey String?  @unique
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashier         User              @relation(fields: [cashierId], references: [id])
  customer        Customer?         @relation(fields: [customerId], references: [id])
  shift           CashierShift?     @relation(fields: [shiftId], references: [id])
  items           SaleItem[]
  payments        Payment[]
  invoiceSaleLink InvoiceSaleLink[]

  @@map("sales")
}

model SaleItem {
  id             String  @id @default(uuid())
  saleId         String
  menuItemId     String
  quantity       Int
  unitPrice      Decimal @db.Decimal(14, 2)
  subtotal       Decimal @db.Decimal(14, 2)
  taxAmount      Decimal @default(0.00) @db.Decimal(14, 2)
  unitCost       Decimal @default(0.00) @db.Decimal(14, 2)
  notes          String?

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("sale_items")
}

model Payment {
  id            String   @id @default(uuid())
  saleId        String?
  invoiceId     String?
  paymentMethod String // CASH, AIRTEL_MONEY, MTN_MOMO, BANK_TRANSFER, CARD, CUSTOMER_CREDIT
  amount        Decimal  @db.Decimal(14, 2)
  reference     String?
  receivedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  sale    Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ----------------------------------------------------
// Invoicing & Consolidated Credit Billing
// ----------------------------------------------------
model Invoice {
  id             String   @id @default(uuid())
  tenantId       String
  customerId     String
  invoiceNumber  String   @unique
  invoiceType    String   @default("STANDARD") // STANDARD, DAILY_CONSOLIDATED, MONTHLY
  issueDate      DateTime @db.Date
  dueDate        DateTime @db.Date
  subtotal       Decimal  @db.Decimal(14, 2)
  taxAmount      Decimal  @default(0.00) @db.Decimal(14, 2)
  totalAmount    Decimal  @db.Decimal(14, 2)
  amountPaid     Decimal  @default(0.00) @db.Decimal(14, 2)
  status         String   @default("ISSUED") // ISSUED, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  deliveryStatus String   @default("PENDING") // PENDING, DELIVERED, FAILED
  pdfUrl         String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments  Payment[]
  saleLinks InvoiceSaleLink[]

  @@map("invoices")
}

model InvoiceSaleLink {
  id        String @id @default(uuid())
  invoiceId String
  saleId    String

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, saleId])
  @@map("invoice_sale_links")
}

// ----------------------------------------------------
// Cashier Shifts & Drawer Balancing
// ----------------------------------------------------
model CashierShift {
  id                    String    @id @default(uuid())
  tenantId              String
  branchId              String
  cashierId             String
  status                String    @default("OPEN") // OPEN, CLOSED, APPROVED
  startedAt             DateTime  @default(now())
  closedAt              DateTime?
  openingFloat          Decimal   @db.Decimal(14, 2)
  cashSales             Decimal   @default(0.00) @db.Decimal(14, 2)
  cashCreditCollections Decimal   @default(0.00) @db.Decimal(14, 2)
  cashExpenses          Decimal   @default(0.00) @db.Decimal(14, 2)
  cashWithdrawals       Decimal   @default(0.00) @db.Decimal(14, 2)
  expectedCash          Decimal   @default(0.00) @db.Decimal(14, 2)
  actualCashCounted     Decimal?  @db.Decimal(14, 2)
  variance              Decimal?  @db.Decimal(14, 2)
  varianceExplanation   String?
  supervisorId          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashier User    @relation(fields: [cashierId], references: [id])
  sales   Sale[]

  @@map("cashier_shifts")
}

// ----------------------------------------------------
// Financials, Expenses & Auditing
// ----------------------------------------------------
model ExpenseCategory {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String
  createdAt DateTime @default(now())

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id            String   @id @default(uuid())
  tenantId      String
  categoryId    String
  amount        Decimal  @db.Decimal(14, 2)
  payee         String
  description   String
  paymentMethod String   @default("CASH")
  receiptNumber String?
  expenseDate   DateTime @default(now())
  approvedById  String?
  createdAt     DateTime @default(now())

  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@map("expenses")
}

model AuditEvent {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String?
  action       String
  entityType   String
  entityId     String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_events")
}

model SyncCommand {
  id             String   @id @default(uuid())
  deviceId       String
  idempotencyKey String   @unique
  commandType    String
  payload        Json
  status         String   @default("PROCESSED") // PROCESSED, CONFLICT, FAILED
  errorMessage   String?
  clientTime     DateTime
  processedAt    DateTime @default(now())

  @@map("sync_commands")
}
