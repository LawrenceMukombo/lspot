# LSpot Restaurant Manager (LRM) - Environment Configuration Template

# Server Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lspot_db?schema=public"

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super-secret-refresh-key-change-in-prod-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Tenant & Defaults
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_BRANCH_ID=00000000-0000-0000-0000-000000000002
CURRENCY=ZMW
TIMEZONE=Africa/Lusaka

# External Integrations (Optional / Configurable)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ZRA_SMART_INVOICE_ENABLED=false
ZRA_API_URL=https://smartinvoice.zra.org.zm/api
