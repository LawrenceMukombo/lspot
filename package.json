{
  "name": "lspot-restaurant-manager",
  "version": "1.0.0",
  "private": true,
  "description": "LSpot Restaurant Manager — Enterprise-Premium Restaurant Management Platform (Manyama, Zambia)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node apps/api/dist/main.js",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @lspot/database db:generate",
    "db:push": "pnpm --filter @lspot/database db:push",
    "db:seed": "pnpm --filter @lspot/database db:seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@11.22.0"
}
